{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dota-chaos-ranked-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "SITE_ORIGIN": "https://eljke.github.io",
    "SITE_URL": "https://eljke.github.io/dota-chaos-build/",
    "GITHUB_REPOSITORY": "eljke/dota-chaos-build",
    "GITHUB_WORKFLOW_FILE": "verify-ranked-match.yml",
    "GITHUB_WORKFLOW_REF": "master"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dota-chaos-ranked",
      "database_id": "f221c73e-4274-4076-ba30-fd37e8485d76",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
